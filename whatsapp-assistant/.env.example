# =============================================================================
#  Assistant personnel WhatsApp — configuration
#  Le plus simple : lancez ./setup.sh (copie ce fichier en .env et génère les secrets).
# =============================================================================

# --- 1. Sécurité : le SEUL numéro auquel l'assistant obéit -------------------
# Format international, chiffres uniquement, sans "+" ni espaces (ex : 33612345678).
# Tout autre expéditeur, et tous les groupes, sont ignorés.
ALLOWED_PHONE_NUMBER=

# --- 2. Fuseau horaire (nom IANA) --------------------------------------------
TIMEZONE=Asia/Jerusalem

# --- 3. Intelligence artificielle --------------------------------------------
# LLM_PROVIDER : groq | openai | anthropic
#   groq      -> gratuit, une seule clé pour le LLM et Whisper  (https://console.groq.com/keys)
#   openai    -> une seule clé pour GPT et Whisper
#   anthropic -> Claude pour la compréhension ; ajoutez une clé Groq ou OpenAI pour l'audio
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Transcription des notes vocales : groq | openai  (vide = même fournisseur que le LLM,
# ou groq si LLM_PROVIDER=anthropic)
TRANSCRIPTION_PROVIDER=

# Optionnel : forcer un modèle (vide = valeur par défaut du fournisseur)
#   groq : llama-3.3-70b-versatile / whisper-large-v3-turbo
#   openai : gpt-4o-mini / whisper-1        anthropic : claude-haiku-5-5
LLM_MODEL=
TRANSCRIPTION_MODEL=
# Optionnel : serveur compatible OpenAI auto-hébergé (ex. Ollama : http://host.docker.internal:11434/v1)
LLM_BASE_URL=

# --- 4. Rappels ---------------------------------------------------------------
# Heure utilisée quand vous ne précisez pas d'heure ("rappelle-moi dans deux semaines")
DEFAULT_REMINDER_TIME=09:00
# Résumé quotidien envoyé sur WhatsApp (HH:mm, vide = désactivé)
DAILY_BRIEFING_TIME=08:00

# --- 5. Google Calendar / Google Tasks (optionnel) ----------------------------
# Laissez vide pour désactiver. Voir README.md > "Synchronisation Google".
# Les RDV vont dans Google Calendar, le reste dans Google Tasks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- 6. Secrets générés automatiquement par ./setup.sh (ne pas partager) ------
# Clé admin OpenWA (en-tête X-API-Key), 32 caractères minimum
OPENWA_API_KEY=
# Secret HMAC de signature des webhooks OpenWA -> backend
WEBHOOK_SECRET=
# Nom de la session WhatsApp dans OpenWA
OPENWA_SESSION_NAME=assistant
